POSTGRES_DB=identitybridge
POSTGRES_USER=identitybridge
POSTGRES_PASSWORD=CHANGE_ME

KEYCLOAK_ADMIN=ib-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

OIDC_ISSUER_URL=http://localhost:8180/realms/identitybridge
OIDC_CLIENT_ID=identitybridge-api
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
APP_ORIGIN=http://localhost:8000
SESSION_SECRET=CHANGE_ME

# Dedicated Keycloak service account (never reuse the user-login client secret)
KEYCLOAK_ADMIN_CLIENT_ID=identitybridge-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# IdentityBridge application database (separate from Keycloak database)
DATABASE_URL=postgresql+psycopg://identitybridge:CHANGE_ME@localhost:55432/identitybridge_app

# Authentication endpoint rate limits
LOGIN_RATE_LIMIT=10
CSRF_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60
